###> symfony/framework ###
APP_SECRET="ThisIsNotSecretForSellsy"
###< symfony/framework ###

################################################################################
# Sellsy Staging Oauth2 Application
# Ask yours to your main Sellsy contact
################################################################################
SELLSY_STAGING_CLIENT_ID=""
SELLSY_STAGING_CLIENT_SECRET=""

################################################################################
# ngrok tunnel — opt-in via `docker compose --profile tunnel up -d ngrok`.
# Sellsy needs a public https url for WebHooks & Oauth2 redirections.
# NGROK_AUTHTOKEN: required, copy from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_URL:       reserved subdomain; drop the --url flag in docker/ngrok.yml
#                  for an ephemeral URL.
################################################################################
NGROK_AUTHTOKEN=""
NGROK_URL=""
