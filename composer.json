{
    "name":                 "splash/sellsy",
    "description":          "Splash Sellsy OpenAPI Connector (Embedded)",

    "type":                 "symfony-bundle",
    "license":              "MIT",
    "minimum-stability":    "dev",
    "prefer-stable":        true,

    "authors": [
        {
            "name":"Splash Sync",
            "email":"contact@splashsync.com"
        },
        {
            "name": "BadPixxel",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],

    "autoload": {
        "psr-4": { 
            "Splash\\Connectors\\Sellsy\\":             "src/"
        }
    },
    
    "autoload-dev": {
        "psr-4": {
            "Splash\\Connectors\\Sellsy\\Test\\":       "tests/"
        }        
    },

    "require": {
        "php":                                          "^8.3",
        "ext-json":                                     "*",
        "splash/php-bundle":                            "^3.0",
        "splash/openapi":                               "^3.0",
        "splash/metadata":                              "^3.0",
        "splash/oauth2":                                "^3.0",
        "splash/scopes":                                "^1.0",
        "symfony/translation":                          "^7.4",
        "symfony/validator":                            "^7.4"
    },
    
    "require-dev": {
        "badpixxel/php-sdk":                            "^3.0",
        "splash/toolkit":                               "^3.0",
        "splash/bridge-builder":                        "^3.0",
        "api-platform/core":                            "^4.0"
    },

    "config": {
        "allow-plugins": {
            "phpro/grumphp":            true,
            "phpro/grumphp-shim":       true,
            "symfony/runtime":          true,
            "php-http/discovery":       true
        }
    },

    "archive": {
        "exclude": ["/bin", "/ci", "/docs", "/docker", "/tests"]
    },

    "scripts": {
        "auto-scripts": [
            "php bin/console cache:clear",
            "php bin/console assets:install --relative",
            "php bin/console doctrine:schema:update --force --complete --no-interaction --no-debug",
            "find var/cache/dev/*.xml -not -name \"testContainer.xml\" | while read -r i; do cp \"$i\" var/cache/dev/testContainer.xml; done"
        ],
        "post-install-cmd": [
            "@auto-scripts",
            "php bin/console sonata:user:create Toolkit toolkit@splashsync.com toolkit --super-admin || exit 0"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "public-dir": "tests/public",
        "branch-alias": {
            "dev-main":     "2.0.x-dev"
        }
    }
}
